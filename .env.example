# YouTube Data API v3 key (required for search/video-details ingestion)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Set this in Cloud Run to use persistent Cloud Storage instead of local JSON files.
KNOWLEDGE_BASE_BUCKET=knowledge-base-bucket
KNOWLEDGE_BASE_OBJECT=knowledge-base.json
# Cloud Run uses its service account; customers never provide an AI key.
GOOGLE_CLOUD_PROJECT=ai-dj-mix
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash-001
